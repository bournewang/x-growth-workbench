{
  "manifest_version": 3,
  "name": "X涨粉工作台",
  "version": "0.7.4",
  "version_name": "0.7.4 修复更新后侧栏关注漏计",
  "description": "在 X 同屏阅读与筛选评论，记录发帖、回复和今日关注操作。",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "native-profile-service-worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "X涨粉工作台 · 本浏览器记录",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://pro.x.com/*",
        "https://pro.twitter.com/*",
        "https://tweetdeck.twitter.com/*"
      ],
      "js": [
        "runtime-client.js",
        "bridge.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://pro.x.com/*",
        "https://pro.twitter.com/*",
        "https://tweetdeck.twitter.com/*"
      ],
      "js": [
        "core.js",
        "tweet-detail-core.js",
        "observer.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "nonfollowers.js",
        "sidex-page-bridge.js"
      ],
      "all_frames": false,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "license-config.js",
        "core.js",
        "sidex-core.js",
        "comment-filter.js",
        "nonfollowers.js",
        "sidex-content.js"
      ],
      "css": [
        "sidex-sidebar.css",
        "xpc-sidex-filters.css",
        "nonfollowers.css"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://upload.x.com/*",
    "https://upload.twitter.com/*",
    "https://translate.googleapis.com/*"
  ]
}
